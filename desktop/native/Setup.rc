#include <windows.h>
#include "build/payload.rc.h"
101 ICON "build/app.ico"
11 RCDATA GA_MSI_PAYLOAD
12 RCDATA GA_MSI_HASH
1 RT_MANIFEST "App.manifest"
1 VERSIONINFO
 FILEVERSION 0,1,19,0
 PRODUCTVERSION 0,1,19,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Greater Art\0"
   VALUE "FileDescription", "Greater Art Desktop Offline Setup\0"
   VALUE "FileVersion", "0.1.19\0"
   VALUE "ProductName", "Greater Art Desktop\0"
   VALUE "ProductVersion", "0.1.19\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

